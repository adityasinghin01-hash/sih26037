# datasets - never commit
# NOTE: anchored with a leading slash. A bare 'meteor/' also matched
# ml/python/meteor/, which silently excluded our own source folder.
/meteor/
*.osm
METEOR_Dataset.zip
chunk_*
data/

# results and models
results/
*.onnx
# feature arrays - Stream C's rule: datasets and derived arrays never enter the repo
*.npz
# torch's dynamo exporter writes the weights to a sidecar file next to the .onnx
*.onnx.data
*.pt
*.pth
*.mat
*.slxc

# blender
*.blend1
blender/renders/
# rendered images are build output, not source - keep them out of git history.
# they were entering via world/build/city work; regenerate from the build scripts.
world/renders/

# matlab
slprj/
codegen/
*.asv
*.autosave

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# os
.DS_Store
OpenTrafficLab/

# Personal per-stream permission fence — see .claude/fences/README.md
.claude/settings.local.json
