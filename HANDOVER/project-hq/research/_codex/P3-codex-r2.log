   118	
   119	function [s, v] = iRamp(v0, a, t, vMin, vMax)
   120	%IRAMP  Distance and speed under constant acceleration, with the speed held
   121	%       inside [vMin vMax]. Solved exactly rather than integrated numerically,
   122	%       so a stop is a stop and not a stop plus half a step of drift.
   123	v = min(max(v0 + a .* t, vMin), vMax);
   124	s = zeros(size(t));
   125	
   126	if a == 0
   127	    s = v0 .* t;
   128	    return
   129	end
   130	
   131	% Time at which the ramp meets whichever limit it is heading for.
   132	if a < 0
   133	    tLim = (vMin - v0) / a;
   134	else
   135	    tLim = (vMax - v0) / a;
   136	end
   137	tLim = max(tLim, 0);
   138	
   139	before = t <= tLim;
   140	s(before) = v0 .* t(before) + 0.5 * a .* t(before).^2;
   141	
   142	sLim  = v0 * tLim + 0.5 * a * tLim^2;
   143	vLim  = v0 + a * tLim;
   144	after = ~before;
   145	s(after) = sLim + vLim .* (t(after) - tLim);
   146	end
   147	
   148	function iRequireFields(s, names, argName)
   149	missing = names(~isfield(s, names));
   150	if ~isempty(missing)
   151	    error('sih:planner:predictAgentFutures:missingField', ...
   152	          '%s is missing required field(s): %s', argName, strjoin(missing, ', '));
   153	end
   154	end

