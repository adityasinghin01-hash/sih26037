   106	function f = iFuture(track, label, prob, valid, t, p0, unit, theta, s, v)
   107	n = numel(t);
   108	f = struct( ...
   109	    'TrackID',     uint32(track.TrackID), ...
   110	    'Label',       label, ...
   111	    'Probability', prob, ...
   112	    'Valid',       valid, ...
   113	    'Times',       t, ...
